# ============================================================
# InspirationOS — environment configuration template
# Copy to `.env` and fill in values. `.env` is gitignored;
# NEVER commit real secrets. Every variable is documented here.
# ============================================================

# --- Core ---
# Environment name: development | test | production
ENV=development
# Secret key for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-one
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Database (PostgreSQL + pgvector) ---
# Dev default matches docker-compose service names.
DATABASE_URL=postgresql+psycopg://inspiration:inspiration@localhost:5432/inspiration
POSTGRES_USER=inspiration
POSTGRES_PASSWORD=inspiration
POSTGRES_DB=inspiration

# --- Redis (sessions + RQ job queues) ---
REDIS_URL=redis://localhost:6379/0

# --- File storage ---
# Root directory for all private files (uploaded ZIPs, generated exports).
# Must be a gitignored path. Later swappable for S3-compatible storage.
DATA_DIR=./var/data
# Maximum accepted upload size in megabytes.
MAX_UPLOAD_SIZE_MB=2048
# ZIP-bomb caps for uploaded archives: maximum entry count, maximum total
# declared uncompressed size (MB), and maximum per-entry compression ratio.
MAX_ZIP_ENTRIES=100000
MAX_ZIP_UNCOMPRESSED_MB=10240
MAX_ZIP_COMPRESSION_RATIO=100

# --- Instagram parser ---
# Same-sender messages within ± this many seconds of a shared link are
# concatenated into the item's adjacent context text.
ADJACENT_TEXT_WINDOW_SECONDS=120

# --- Metadata enrichment (OFF by default; consent-gated in-app) ---
# These are ceilings/defaults; the actual on/off switch lives in app
# settings and requires explicit consent in the UI.
ENRICHMENT_REQUESTS_PER_MINUTE=20
ENRICHMENT_TIMEOUT_SECONDS=10

# --- AI providers ---
# Active provider: mock | anthropic | openai   (mock needs no key)
AI_PROVIDER=mock
# Anthropic (default real provider)
ANTHROPIC_API_KEY=
ANTHROPIC_GENERATION_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
# OpenAI (selectable alternative)
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5.2
OPENAI_FAST_MODEL=gpt-5-mini
# Monthly spend ceiling in USD; AI jobs refuse to start beyond it.
AI_MONTHLY_BUDGET_USD=10

# --- Embeddings ---
# local = fastembed (no key, default) | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Frontend ---
# Where the Next.js dev server proxies /api/* requests.
BACKEND_URL=http://localhost:8000

# --- Production only (M9) ---
# Domain for Caddy automatic HTTPS, e.g. inspiration.example.com
APP_DOMAIN=
# Email for Let's Encrypt registration
ACME_EMAIL=
